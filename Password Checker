import math
import re


def evaluate_password(password):
    if not password:
        return 0, "Çok Zayıf", 0, 0, "Anında", ["Parola boş olamaz."]

    charset_size = 0
    types_used = 0

    if re.search(r"[a-z]", password):
        charset_size += 26
        types_used += 1
    if re.search(r"[A-Z]", password):
        charset_size += 26
        types_used += 1
    if re.search(r"[0-9]", password):
        charset_size += 10
        types_used += 1
    if re.search(r'[!@#$%^&*(),.?":{}|<>]', password):
        charset_size += 32
        types_used += 1

    length = len(password)
    total_combinations = charset_size**length
    avg_attempts = total_combinations // 2

    hashes_per_second = 10_000_000_000
    seconds_to_crack = avg_attempts / hashes_per_second


    if seconds_to_crack < 1:  
        time_score = 1
    elif seconds_to_crack < 3600:  
        time_score = 2
    elif seconds_to_crack < 86400 * 30: 
        time_score = 3
    elif seconds_to_crack < 86400 * 365:  
        time_score = 4
    elif seconds_to_crack < 86400 * 365 * 10:  
        time_score = 5
    elif seconds_to_crack < 86400 * 365 * 1000:  
        time_score = 6
    else:  
        time_score = 7

    variety_score = min(3, types_used)

    total_score = time_score + variety_score

    if length < 6:
        total_score = min(total_score, 3)

    if total_score >= 9:
        status = "Mükemmel (Kırılamaz Düzeyde)"
    elif total_score >= 7:
        status = "Güçlü"
    elif total_score >= 5:
        status = "Orta"
    elif total_score >= 3:
        status = "Zayıf"
    else:
        status = "Çok Zayıf"

    feedback = []
    if length < 12:
        feedback.append("Parola uzunluğunu en az 12 karaktere çıkarın.")
    if types_used < 4:
        feedback.append(
            "Büyük harf, küçük harf, rakam ve özel karakterlerin hepsini kullanmaya çalışın."
        )

    return (
        total_score,
        status,
        total_combinations,
        avg_attempts,
        format_time(seconds_to_crack),
        feedback,
    )


def format_time(seconds):
    if seconds < 1:
        return "Anında (1 saniyenin altında)"

    minutes = seconds / 60
    hours = minutes / 60
    days = hours / 24
    years = days / 365
    centuries = years / 100

    if centuries >= 1:
        return f"{centuries:.1f} Yüzyıl"
    elif years >= 1:
        return f"{years:.1f} Yıl"
    elif days >= 1:
        return f"{days:.1f} Gün"
    elif hours >= 1:
        return f"{hours:.1f} Saat"
    elif minutes >= 1:
        return f"{minutes:.1f} Dakika"
    else:
        return f"{seconds:.1f} Saniye"


if __name__ == "__main__":
    pwd = input("Analiz edilecek parolayı girin: ")

    score, status, total_comb, avg_attempts, est_time, suggestions = (
        evaluate_password(pwd)
    )

    print("\n================ ANALİZ SONUCU ================")
    print(f"Parola Puanı                 : {score} / 10")
    print(f"Güvenlik Durumu             : {status}")
    print(f"Toplam Olası Kombinasyon    : {total_comb:,}")
    print(f"Ortalama Tahmini Deneme     : {avg_attempts:,}")
    print(f"Tahmini Çözülme Süresi (GPU): {est_time}")

    if suggestions:
        print("\n--- İyileştirme Önerileri ---")
        for s in suggestions:
            print(f"- {s}")

    print("\n" + "=" * 47)
    input("Çıkış yapmak için Enter tuşuna basın...")

